<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>com.aksoyakin.cryptopayment</groupId>
    <artifactId>crypto-payment</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>Crypto Payment</name>
    <description>Crypto payment gateway for merchants</description>

    <modules>
        <module>libs/event-contracts</module>
        <module>services/api</module>
        <module>services/chain-watcher</module>
        <module>services/signer</module>
    </modules>

    <properties>
        <java.version>27</java.version>
        <maven.compiler.release>27</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Boot 4.1.1 manages 1.18.46; JDK 27 support starts at 1.18.48 -->
        <lombok.version>1.18.48</lombok.version>
        <spring-modulith.version>2.1.1</spring-modulith.version>
        <archunit.version>1.5.1</archunit.version>
        <web3j.version>4.14.0</web3j.version>
        <tuweni.version>2.7.0</tuweni.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.aksoyakin.cryptopayment</groupId>
                <artifactId>event-contracts</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springframework.modulith</groupId>
                <artifactId>spring-modulith-bom</artifactId>
                <version>${spring-modulith.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Spring Modulith 2.1.1 brings ArchUnit 1.4.2; Java 27 class files need 1.5.x -->
            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit</artifactId>
                <version>${archunit.version}</version>
            </dependency>
            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit-junit5</artifactId>
                <version>${archunit.version}</version>
            </dependency>
            <!-- web3j for what is hard to get right by hand: secp256k1, RLP and ABI encoding. Its 'core'
                 artifact is not used; the JSON-RPC transport is ours (ADR 0022). -->
            <dependency>
                <groupId>org.web3j</groupId>
                <artifactId>crypto</artifactId>
                <version>${web3j.version}</version>
                <exclusions>
                    <exclusion>
                        <groupId>io.consensys.tuweni</groupId>
                        <artifactId>*</artifactId>
                    </exclusion>
                    <!-- Only web3j's keystore files need Jackson 2, and key storage here is AES-GCM of our
                         own (ADR 0017). Boot's Jackson 3 stays the only JSON library in the image. -->
                    <exclusion>
                        <groupId>com.fasterxml.jackson.core</groupId>
                        <artifactId>*</artifactId>
                    </exclusion>
                </exclusions>
            </dependency>
            <dependency>
                <groupId>org.web3j</groupId>
                <artifactId>abi</artifactId>
                <version>${web3j.version}</version>
                <exclusions>
                    <exclusion>
                        <groupId>io.consensys.tuweni</groupId>
                        <artifactId>*</artifactId>
                    </exclusion>
                    <!-- Only web3j's keystore files need Jackson 2, and key storage here is AES-GCM of our
                         own (ADR 0017). Boot's Jackson 3 stays the only JSON library in the image. -->
                    <exclusion>
                        <groupId>com.fasterxml.jackson.core</groupId>
                        <artifactId>*</artifactId>
                    </exclusion>
                </exclusions>
            </dependency>
            <!-- Pulled back in without its optional adapters: tuweni's Bytes is on web3j's API, but its
                 Vert.x buffer and ConnId bridges would drag Netty and Vert.x into a payment service. -->
            <dependency>
                <groupId>io.consensys.tuweni</groupId>
                <artifactId>tuweni-bytes</artifactId>
                <version>${tuweni.version}</version>
                <exclusions>
                    <exclusion>
                        <groupId>io.vertx</groupId>
                        <artifactId>*</artifactId>
                    </exclusion>
                    <exclusion>
                        <groupId>org.connid</groupId>
                        <artifactId>*</artifactId>
                    </exclusion>
                </exclusions>
            </dependency>
            <dependency>
                <groupId>io.consensys.tuweni</groupId>
                <artifactId>tuweni-units</artifactId>
                <version>${tuweni.version}</version>
                <exclusions>
                    <exclusion>
                        <groupId>io.vertx</groupId>
                        <artifactId>*</artifactId>
                    </exclusion>
                    <exclusion>
                        <groupId>org.connid</groupId>
                        <artifactId>*</artifactId>
                    </exclusion>
                </exclusions>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <annotationProcessorPaths>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                                <version>${lombok.version}</version>
                            </path>
                        </annotationProcessorPaths>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
